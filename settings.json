{
  "theme": "Gruvbox Dark",
  "buffer_font_family": "MonoLisa",
  "features": {
    "edit_prediction_provider": "zed"
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "assistant": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-3-7-sonnet-latest"
    },
    "version": "2"
  },
  "tabs": {
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "confirm_quit": true,
  "buffer_font_size": 13,
  "autosave": "on_focus_change",
  "cursor_blink": false,
  // "inlay_hints": {
  //   "enabled": true
  // },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "collaboration_panel": {
    "button": false
  }
}
