{
  "theme": {
    "mode": "system",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark"
  },
  "buffer_font_family": "MonoLisa Variable",
  "buffer_font_size": 13,
  "ui_font_family": "PT Sans",
  "features": {
    "edit_prediction_provider": "zed"
  },
  "edit_predictions": {
    "disabled_globs": [],
    "mode": "eager"
  },
  "agent": {
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    },
    "version": "2"
  },
  "tabs": {
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "enable_vim_sneak": true
  },
  "confirm_quit": true,
  "autosave": "on_focus_change",
  "cursor_blink": false,
  "inlay_hints": {
    "enabled": true
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "collaboration_panel": {
    "button": false
  }
}
