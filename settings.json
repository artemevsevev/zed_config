{
  "icon_theme": {
    "mode": "system",
    "light": "JetBrains Icons Light",
    "dark": "JetBrains Icons Dark"
  },
  "theme": {
    "mode": "system",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark"
  },
  "buffer_font_family": "MonoLisa Variable",
  "buffer_font_size": 13,
  "ui_font_family": "PT Sans",
  "features": {
    "edit_prediction_provider": "zed"
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "agent": {
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    }
  },
  "tabs": {
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "confirm_quit": true,
  "autosave": "on_focus_change",
  "cursor_blink": false,
  "inlay_hints": {
    "enabled": true,
    "show_background": true
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "collaboration_panel": {
    "button": false
  },
  "auto_signature_help": true,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "project_panel": {
    "hide_root": true
  },
  "git_panel": {
    "dock": "right"
  },
  "lsp_document_colors": "border",
  "profiles": {
    "Mac": {
      "buffer_font_size": 13
    }
  }
}
